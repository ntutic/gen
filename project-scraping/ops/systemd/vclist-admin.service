[Unit]
Description=Vclist spider administration (loopback only)
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecStartPre="@REPO_ROOT@/.venv/bin/python" -m scrapectl prepare-db
ExecStart="@REPO_ROOT@/.venv/bin/python" -m scrapectl serve-admin --port @PORT@
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
